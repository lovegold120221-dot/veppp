# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase remains the auth and user-profile source of truth.
# Edit firebase-applet-config.json for Firebase project/database config.

# Supabase is used for global app database mirrors and file storage.
# This is a browser/Vite app, so use VITE_ variables. NEXT_PUBLIC_ aliases
# are also accepted for compatibility with copied Next.js setup snippets.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
VITE_SUPABASE_STORAGE_BUCKET="vep-global-storage"
VITE_SUPABASE_CHAT_MESSAGES_TABLE="vep_chat_messages"
VITE_SUPABASE_KNOWLEDGE_FILES_TABLE="vep_knowledge_files"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Google personal-service integration.
VITE_GOOGLE_API_KEY="MY_GOOGLE_API_KEY"
VITE_ZAPIER_MCP_EMBED_ID="MY_ZAPIER_MCP_EMBED_ID"
